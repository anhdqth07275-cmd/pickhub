<%@ include file="layout.jspf" %>
<section class="auth"><h1>Thông tin tài khoản</h1><c:if test="${not empty loi}"><div class="alert error"><c:out value="${loi}"/></div></c:if><c:if test="${param.doiMatKhau == '1'}"><div class="alert ok">Đổi mật khẩu thành công.</div></c:if><c:if test="${param.capNhat == '1'}"><div class="alert ok">Cập nhật hồ sơ thành công.</div></c:if><form method="post" action="${ctx}/tai-khoan/ho-so"><label>Họ tên</label><input name="hoTen" value="<c:out value='${kh.hoTen}'/>" required><label>Email (không thể tự đổi)</label><input value="<c:out value='${kh.thuDienTu}'/>" disabled><label>Số điện thoại</label><input name="soDienThoai" value="${kh.soDienThoai}" required><label>Ngày sinh</label><input type="date" name="ngaySinh" value="${kh.ngaySinh}"><button>Lưu thay đổi</button></form><hr><h2>Đổi mật khẩu</h2><form method="post" action="${ctx}/tai-khoan/ho-so"><input type="hidden" name="hanhDong" value="doi-mat-khau"><label>Mật khẩu hiện tại</label><input type="password" name="matKhauCu" required><label>Mật khẩu mới</label><input type="password" name="matKhauMoi" minlength="8" required><label>Nhập lại mật khẩu mới</label><input type="password" name="nhapLai" minlength="8" required><button>Đổi mật khẩu</button></form></section>
<%@ include file="footer.jspf" %>
