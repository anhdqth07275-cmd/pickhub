<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>PickHub</title><link rel="stylesheet" href="${ctx}/assets/frontend.css"><link rel="stylesheet" href="${ctx}/assets/select-search.css"><script src="${ctx}/assets/select-search.js" defer></script></head><body>
<header class="top"><a class="brand" href="${ctx}/">PICK<span>HUB</span></a><nav><a href="${ctx}/">Trang chủ</a><c:choose><c:when test="${not empty sessionScope.khachHang}"><a href="${ctx}/tai-khoan/ho-so">Tài khoản</a><a href="${ctx}/tai-khoan/dang-xuat">Đăng xuất</a></c:when><c:otherwise><a href="${ctx}/tai-khoan/dang-nhap">Đăng nhập</a><a href="${ctx}/tai-khoan/dang-ky">Đăng ký</a></c:otherwise></c:choose></nav></header><main class="wrap">
