<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="/trang-chu-backend/layout/header.jspf" %>
<form class="toolbar" method="get" action="${ctx}/wp-admin/nhan-vien"><input class="grow" type="text" name="tuKhoa" value="<c:out value='${param.tuKhoa}'/>" placeholder="Tìm tên, email, SĐT..."><select name="trangThai"><option value="">Mọi trạng thái</option><c:forTokens items="HOAT_DONG,CHUA_XAC_THUC,KHOA" delims="," var="t"><option value="${t}" ${param.trangThai == t ? 'selected' : ''}>${ph:nhan(t)}</option></c:forTokens></select><button class="btn" type="submit">Lọc</button></form>
<details class="card" style="margin-bottom:16px"><summary style="cursor:pointer;font-weight:700">+ Tạo tài khoản nhân viên</summary><form method="post" action="${ctx}/wp-admin/nhan-vien" class="form-grid"><input type="hidden" name="hanhDong" value="them"><label>Họ tên<input name="hoTen" maxlength="100" required></label><label>Email<input type="email" name="email" maxlength="255" required></label><label>Số điện thoại<input name="soDienThoai" maxlength="15" required></label><label>Ngày sinh<input type="date" name="ngaySinh"></label><label>Vai trò<select name="vaiTro"><option value="NHAN_VIEN">Nhân viên</option><c:if test="${coTheTaoQuanLy}"><option value="QUAN_LY">Quản lý</option><option value="QUAN_TRI">Quản trị viên</option></c:if></select></label><label>Mật khẩu khởi tạo<input type="password" name="matKhau" minlength="8" required></label><button class="btn lime" type="submit">Tạo tài khoản</button></form></details>
<div class="card table-wrap" style="padding:0"><table class="tbl"><tr><th>Họ tên</th><th>Email</th><th>SĐT</th><th>Vai trò</th><th>Trạng thái</th><th>Đăng nhập gần nhất</th><th>Thao tác</th></tr><c:forEach items="${pt.danhSach}" var="u"><tr><td><b><c:out value="${u.hoTen}"/></b></td><td><c:out value="${u.thuDienTu}"/></td><td>${u.soDienThoai}</td><td>${ph:nhan(u.vaiTro)}</td><td><span class="badge ${u.trangThai}">${ph:nhan(u.trangThai)}</span><c:if test="${u.trangThai == 'KHOA'}"><br><span class="muted">${u.lyDoKhoa}</span></c:if></td><td class="nowrap">${ph:ngayGio(u.ngayDangNhapCuoi)}</td><td class="nowrap"><c:if test="${u.maNhanVien != sessionScope.taiKhoan.id}"><c:choose><c:when test="${u.trangThai == 'KHOA'}"><form class="inline" method="post"><input type="hidden" name="hanhDong" value="mo-khoa"><input type="hidden" name="id" value="${u.maNhanVien}"><button class="btn sm lime">Mở khóa</button></form></c:when><c:otherwise><form class="inline" method="post" onsubmit="var x=prompt('Nhập lý do khóa:');if(x===null||!x.trim())return false;this.lyDo.value=x;return true"><input type="hidden" name="hanhDong" value="khoa"><input type="hidden" name="id" value="${u.maNhanVien}"><input type="hidden" name="lyDo"><button class="btn sm danger">Khóa</button></form></c:otherwise></c:choose><c:if test="${sessionScope.taiKhoan.vaiTro == 'QUAN_TRI'}"><form class="inline" method="post"><input type="hidden" name="hanhDong" value="doi-vai-tro"><input type="hidden" name="id" value="${u.maNhanVien}"><select name="vaiTro"><option value="NHAN_VIEN" ${u.vaiTro=='NHAN_VIEN'?'selected':''}>Nhân viên</option><option value="QUAN_LY" ${u.vaiTro=='QUAN_LY'?'selected':''}>Quản lý</option><option value="QUAN_TRI" ${u.vaiTro=='QUAN_TRI'?'selected':''}>Quản trị</option></select><button class="btn sm">Lưu quyền</button></form><form class="inline" method="post" onsubmit="var x=prompt('Nhập mật khẩu mới (ít nhất 8 ký tự, có chữ và số):');if(x===null||x.length<8)return false;this.matKhauMoi.value=x;return true"><input type="hidden" name="hanhDong" value="dat-lai-mat-khau"><input type="hidden" name="id" value="${u.maNhanVien}"><input type="hidden" name="matKhauMoi"><button class="btn sm">Đặt lại mật khẩu</button></form></c:if></c:if></td></tr></c:forEach><c:if test="${empty pt.danhSach}"><tr><td colspan="7" class="empty">Không có dữ liệu</td></tr></c:if></table></div>
<%@ include file="/trang-chu-backend/layout/phan-trang.jspf" %>
<%@ include file="/trang-chu-backend/layout/footer.jspf" %>
